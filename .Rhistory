cbind(groupcol=rep(c("orangered3","skyblue4","seagreen","maroon4"), times=summary(.$g)))
pa_int_plot <- cov2cor(pa_interaction) %>%
as.matrix() %>% reshape2::melt() %>%
cbind(.,tri=tri$value) %>% .[which(.$tri),]
ar_int_plot <- cov2cor(ar_interaction) %>%
as.matrix() %>% reshape2::melt() %>%
cbind(.,tri=tri$value) %>% .[which(.$tri),]
pa_pref <- table(pa_summary$L1[pa_summary$PC1!=0], pa_summary$pref[pa_summary$PC1!=0]) %>%
as.data.frame() %>% reshape2::dcast(Var1~Var2) %>%
mutate(location_gut=gut+both, location_resp=respiratory+both) %>%
mutate(diff=(location_gut-location_resp)/(location_gut+location_resp)) %>%
mutate(cat_gut=ifelse(diff>(-0.15),T,F),
cat_resp=ifelse(diff<(0.15),T,F))
ar_pref <- table(ar_summary$L1[ar_summary$PC1!=0], ar_summary$pref[ar_summary$PC1!=0]) %>%
as.data.frame() %>% reshape2::dcast(Var1~Var2) %>%
mutate(location_gut=gut+both, location_resp=respiratory+both) %>%
mutate(diff=(location_gut-location_resp)/(location_gut+location_resp)) %>%
mutate(cat_gut=ifelse(diff>(-0.15),T,F),
cat_resp=ifelse(diff<(0.15),T,F))
pa_int_split <- left_join(pa_int_plot, pa_pref[,c(1,8,9)]) %>%
left_join(pa_pref[c(1,8,9)], by=c("Var2"="Var1"))
pa_int_gut <- pa_int_split
pa_int_gut[which(pa_int_gut$cat_gut.x!=pa_int_gut$cat_gut.y|pa_int_gut$cat_gut.x==F),"value"] <- 0
pa_int_resp <- pa_int_split
pa_int_resp[which(pa_int_resp$cat_resp.x!=pa_int_resp$cat_resp.y|pa_int_resp$cat_resp.x==F),"value"] <- 0
ar_int_split <- left_join(ar_int_plot, ar_pref[,c(1,8,9)]) %>%
left_join(ar_pref[c(1,8,9)], by=c("Var2"="Var1"))
ar_int_gut <- ar_int_split
ar_int_gut[which(ar_int_gut$cat_gut.x!=ar_int_gut$cat_gut.y|ar_int_gut$cat_gut.x==F),"value"] <- 0
ar_int_resp <- ar_int_split
ar_int_resp[which(ar_int_resp$cat_resp.x!=ar_int_resp$cat_resp.y|ar_int_resp$cat_resp.x==F),"value"] <- 0
library(cowplot)
my_color_sep <- my_color
my_color_sep$g <- NULL
pa_gut <- as_grob(~chord_plot_fun(pa_int_gut, my_color_sep))
pa_resp <- as_grob(~chord_plot_fun(pa_int_resp, my_color_sep))
pa_int_site <- plot_grid(pa_gut, pa_resp, ncol=1)
ar_gut <- as_grob(~chord_plot_fun(ar_int_gut, my_color_sep))
ar_resp <- as_grob(~chord_plot_fun(ar_int_resp, my_color_sep))
ar_int_site <- plot_grid(ar_gut, ar_resp, ncol=1)
