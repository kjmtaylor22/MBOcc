group_by(L1, g, col, Flock, run) %>%
mutate(Intercept=intercept(Age, PC1), Slope=slope(Age, PC1)) %>%
.[,-5] %>% unique() %>% ggplot() + theme_bw() +
annotate(geom="rect", xmin=-Inf, xmax=Inf, ymin=0, ymax=Inf, alpha=0.15, fill="grey40") +
annotate(geom="text", x=-Inf, y=Inf, color="grey20", label="early colonizers", hjust=-0.1, vjust=1.1) +
#annotate(geom="text", x=-Inf, y=0, color="grey20", label="poor competitors", hjust=-0.2, vjust=1) +
annotate(geom="rect", xmin=0, xmax=Inf, ymin=-Inf, ymax=Inf, alpha=0.15, fill="grey40") +
annotate(geom="text", x=Inf, y=-Inf, color="grey20", label="late invaders", hjust=1.1, vjust=-0.2) +
annotate(geom="text", x=Inf, y=Inf, color="grey20", label="good competitors", hjust=1.1, vjust=1.1) +
geom_point(aes(Slope, Intercept, color=L1, shape=g), size=2.5,  show.legend = c("color"=F)) +
geom_hline(yintercept=0, color="grey40", linetype="dashed") +
geom_vline(xintercept=0, color="grey40", linetype="dashed") +
scale_shape_manual(values=c(17, 18, 15, 19)) +
scale_color_manual(values=unique(pa_summary[c("L1","col")])$col) +
theme(legend.position = "inside", legend.position.inside = c(0.8,0.85),
legend.text = element_text(size=8), legend.background = element_blank(),
legend.key = element_rect(fill = NA), legend.text.position = "left") +
labs(shape=NULL, x="Slope", y="Intercept")
